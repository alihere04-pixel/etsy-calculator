# Environment variables for local development and deployment.
# Copy to `.env.local` and fill in. `.env.local` must never be committed.

# Google Analytics 4 measurement ID for the consent-gated GA4 tracker. GA4
# stays off until this is set AND the visitor accepts analytics in the banner;
# with the variable absent no Google Analytics request is ever made.
NEXT_PUBLIC_GA4_ID=G-TNHCLMDFYX
